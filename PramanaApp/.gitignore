gitignore
# =========================================
# Android Studio & IntelliJ
# Ignores IDE-specific settings and cache files.
# =========================================
*.iml
.idea/
.idea/caches/
.idea/gradle.xml
.idea/misc.xml
.idea/modules.xml
.idea/vcs.xml
.idea/libraries/
.idea/navEditor.xml
.idea/assetWizardSettings.xml
.idea/workspace.xml
.idea/shelf/
.idea/.name

# =========================================
# Gradle
# Ignores files and directories generated by the Gradle build system.
# This is the most important section for reducing repository size.
# =========================================
.gradle/
build/
*/build/

# Don't ignore the Gradle Wrapper jar file, as it's needed for reproducible builds.
!gradle/wrapper/gradle-wrapper.jar

# =========================================
# Local Properties & Sensitive Information
# CRITICAL: Ignores files that contain machine-specific paths or secrets.
# =========================================
local.properties
keystore.properties
*.keystore
*.jks

# It's good practice to add your secrets file to gitignore as well,
# in case you move your API_KEY to a separate constants file.
# secrets.properties

# =========================================
# Android Build Artifacts
# Ignores compiled applications and other build outputs.
# =========================================
captures/
*.apk
*.aab
*.ap_
*.apks
*.dex
output.json

# =========================================
# Operating System Files
# Ignores common OS-specific clutter.
# =========================================
# Mac
.DS_Store
# Windows
Thumbs.db

