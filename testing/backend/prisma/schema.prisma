generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Post {
  id               String   @id @default(uuid())
  title            String
  description      String
  imagePath        String?
  verificationJson String?
  verdict          String?
  truthScore       Float?
  confidence       String?
  explanation      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
